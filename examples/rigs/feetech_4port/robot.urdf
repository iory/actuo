<?xml version="1.0"?>
<robot name="feetech_4port">
  <link name="base_link"/>
  <link name="j1_link"/>
  <joint name="j1" type="revolute"><parent link="base_link"/><child link="j1_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-3.2" upper="3.2" effort="5" velocity="3"/></joint>
  <link name="j2_link"/>
  <joint name="j2" type="revolute"><parent link="j1_link"/><child link="j2_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-3.2" upper="3.2" effort="5" velocity="3"/></joint>
  <link name="j3_link"/>
  <joint name="j3" type="revolute"><parent link="j1_link"/><child link="j3_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-3.2" upper="3.2" effort="5" velocity="3"/></joint>
  <link name="j4_link"/>
  <joint name="j4" type="revolute"><parent link="j1_link"/><child link="j4_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-3.2" upper="3.2" effort="5" velocity="3"/></joint>
</robot>
