<?xml version="1.0"?>
<robot name="wrist">
  <link name="wrist_base"/>
  <link name="j4_link"/>
  <joint name="j4" type="revolute"><parent link="wrist_base"/><child link="j4_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-3.2" upper="3.2" effort="5" velocity="3"/></joint>
  <ros2_control name="wrist" type="system"><joint name="j4"/></ros2_control>
</robot>
