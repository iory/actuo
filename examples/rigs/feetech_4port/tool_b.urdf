<?xml version="1.0"?>
<robot name="tool_b">
  <link name="tool_b_base"/>
  <link name="j3_link"/>
  <joint name="j3" type="revolute"><parent link="tool_b_base"/><child link="j3_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-3.2" upper="3.2" effort="5" velocity="3"/></joint>
  <ros2_control name="tool_b" type="system"><joint name="j3"/></ros2_control>
</robot>
