<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="RNG" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>actuo_msgs</name>
  <version>0.0.1</version>
  <description>
    Interfaces for actuo's ROS 2 layer. The servo (torque) on/off contract: a
    continuously published state topic that is the audit trail, and an action
    whose rejection path is the safety mechanism.
  </description>
  <maintainer email="ab.ioryz@gmail.com">iory</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
